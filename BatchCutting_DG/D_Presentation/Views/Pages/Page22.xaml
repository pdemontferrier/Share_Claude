<Page x:Class="BatchCutting_DG.D_Presentation.Views.Pages.Page22"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BatchCutting_DG.D_Presentation.Views.Pages"
      mc:Ignorable="d" 
      Title="Page22">

    <Grid x:Name="PageGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Col_0" Width="300"/>
            <ColumnDefinition x:Name="Col_1" MinWidth="300" MaxWidth="600"/>
            <ColumnDefinition x:Name="Col_2" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="Row_0" MinHeight="40" MaxHeight="100"/>
            <RowDefinition x:Name="Row_1" MinHeight="40" MaxHeight="100"/>
            <RowDefinition x:Name="Row_2" MinHeight="40" MaxHeight="100"/>
            <RowDefinition x:Name="Row_3" MinHeight="40" MaxHeight="100"/>
            <RowDefinition x:Name="Row_4" MinHeight="40" MaxHeight="100"/>
            <RowDefinition x:Name="Row_5" MinHeight="40" MaxHeight="100"/>
        </Grid.RowDefinitions>

        <!-- First Column for Titles -->
        <TextBlock x:Name="PageTitle" Grid.Row="0" Grid.Column="1" Text="{DynamicResource P22_00}" Grid.ColumnSpan="2"/>
        <TextBlock x:Name="ReferenceTitle" Grid.Row="1" Grid.Column="0" Text="{DynamicResource P22_01}"/>
        <TextBlock x:Name="CouleurTitle" Grid.Row="2" Grid.Column="0" Text="{DynamicResource P22_02}"/>
        <TextBlock x:Name="LongueurTitle" Grid.Row="3" Grid.Column="0" Text="{DynamicResource P22_03}"/>
        <TextBlock x:Name="EmplacementTitle" Grid.Row="4" Grid.Column="0" Text="{DynamicResource P22_04}"/>
        <TextBlock x:Name="ChuteMinTitle" Grid.Row="5" Grid.Column="0" Text="{DynamicResource P22_05}"/>


        <!-- Second Column for Input Controls -->
        <!-- Empty -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
            <TextBlock x:Name="ReferenceData" Text="{Binding DecoupeBarreWithCut.ReferenceArticle}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
            <TextBlock x:Name="CouleurData" Text="{Binding DecoupeBarreWithCut.CouleurArticle}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
            <TextBlock x:Name="LongueurData" Text="{Binding Length, StringFormat={}{0:N0}}" Margin="0,0,10,0"/>
            <Button x:Name="PlusData" Command="{Binding IncrementLengthCommand}">
                <TextBlock x:Name="PlusText" Text="+" />
            </Button>
            <Button x:Name="MinusData" Command="{Binding DecrementLengthCommand}">
                <TextBlock x:Name="MinusText" Text="-" />
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1">
            <TextBlock x:Name="EmplacementData" Text="{Binding DecoupeBarreWithCut.EmpSc}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1">
            <TextBlock x:Name="ChuteMinData" Text="{Binding DecoupeBarreWithCut.LongueurChuteMini, StringFormat={}{0:N0}}"/>
        </StackPanel>


        <!-- Third Column for Image -->
        <Border x:Name="ReferenceVueBorder" Grid.Row="1" Grid.Column="2" Grid.RowSpan="5" Background="LightGray" Padding="10">
            <Image x:Name="ReferenceVueImage" Source="{Binding ReferenceVueUri}" Stretch="Uniform"/>
        </Border>

    </Grid>
</Page>
