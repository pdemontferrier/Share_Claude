<Page x:Class="BatchCutting_DG.D_Presentation.Views.Pages.Page00"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BatchCutting_DG.D_Presentation.Views.Pages"
      mc:Ignorable="d"
      Title="Page00">

    <Grid x:Name="PageGrid">

        <!-- Conteneur principal pour centrer -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Zone encadrée -->
            <Border x:Name="IdentificationBorder" Grid.Row="1" Grid.Column="1" CornerRadius="10" Padding="20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>

                    <!-- Première ligne -->
                    <TextBlock x:Name="IdentificationData" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               VerticalAlignment="Center" Text="{DynamicResource P00_00}"/>

                    <!-- Deuxième ligne -->
                    <TextBlock x:Name="LoginTitle" Grid.Row="1" Grid.Column="0" 
                               VerticalAlignment="Center" Text="{DynamicResource P00_01}"/>
                    <Border x:Name="LoginBorder" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="LoginInput"/>
                    </Border>

                    <!-- Troisième ligne -->
                    <TextBlock x:Name="PasswordTitle" Grid.Row="2" Grid.Column="0"
                               VerticalAlignment="Center" Text="{DynamicResource P00_02}"/>
                    <Border x:Name="PasswordBorder" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                        <PasswordBox x:Name="PasswordInput"/>
                    </Border>

                    <!-- Troisième colonne : bouton -->
                    <Button x:Name="LoginButton" Grid.Row="1" Grid.Column="2" Grid.RowSpan="2"
                            VerticalAlignment="Center" Click="On_Valider_Click">
                        <TextBlock x:Name="LoginButtonText" Text="{DynamicResource P00_03}"/>
                    </Button>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
