<!-- ============================================================
     MH20 — MENU HORIZONTAL ASSOCIÉ À Page20
     ============================================================
     Contexte : Menu horizontal de la page de production (Page20),
     sur laquelle l'application présente à l'opérateur la barre
     retenue pour la série en cours. Expose les quatre boutons
     transverses standards du socle (MH_Menu bindé sur
     ReduceCommand au titre de la doctrine du double rôle,
     MH_Home, MH_Previous, MH_Refresh) augmentés de trois boutons
     d'action MH_Validate, MH_Reject et MH_OutOfStock, et d'un
     bouton de navigation contextuelle MH_Details ouvrant la page
     de détail de la série (Page11).

     Objectif : Porter les gestes de l'opérateur sur la barre
     présentée : la valider (avec ou sans défauts saisis sur la
     page), la refuser, la déclarer en rupture de stock, et
     consulter le détail de la série en cours. Les trois boutons
     d'action déclenchent respectivement ValidateCommand,
     RejectCommand et OutOfStockCommand ; le bouton de détail
     déclenche DetailsCommand. Chaque bouton affiche le libellé
     multilingue propre correspondant.

     Comportement : MH20 hérite de MH_Generic (§4.15.9 du 0230)
     et binde son DataContext sur VM_MH20 (§4.15.8 du 0230). La
     visibilité des quatre boutons transverses est gouvernée par
     les implémentations par défaut d'ApplyNavigationRules et
     d'ApplySecurityRules du socle. Les trois boutons d'action
     sont visibles sans condition : aucun droit métier ne les
     distingue, et leur disponibilité est portée par l'activation
     des commandes (gardes du ViewModel), non par leur visibilité.
     Le bouton MH_Details est masqué à la déclaration
     (Visibility="Collapsed") et révélé au Loaded par l'override
     propre d'ApplyNavigationRules du code-behind, sous condition
     du droit d'accès de l'utilisateur courant à la page cible
     (R-4.13.14 du 0231). La stylisation des quatre boutons
     propres est portée par l'override propre d'ApplyLayout.
     ============================================================ -->

<generic:MH_Generic x:Class="DG244Cutting.D_Presentation.Views.Components.HorizontalMenus.MH20"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:generic="clr-namespace:DG244Cutting.D_Presentation.Views.Generic"
                    mc:Ignorable="d">

    <Grid x:Name="MH_Grid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MH_Grid_C1"/>
            <ColumnDefinition x:Name="MH_Grid_C2"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="MH_Border" Grid.Column="1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="MH_Home" Command="{Binding HomeCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Home_Icon"/>
                            <TextBlock x:Name="MH_Home_Text" Text="{Binding Label_MH_Home}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Previous" Command="{Binding PreviousCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Previous_Icon"/>
                            <TextBlock x:Name="MH_Previous_Text" Text="{Binding Label_MH_Previous}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Refresh" Command="{Binding RefreshCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Refresh_Icon"/>
                            <TextBlock x:Name="MH_Refresh_Text" Text="{Binding Label_MH_Refresh}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MH_Validate" Command="{Binding ValidateCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Validate_Icon"/>
                            <TextBlock x:Name="MH_Validate_Text" Text="{Binding Label_MH_Validate}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Reject" Command="{Binding RejectCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Reject_Icon"/>
                            <TextBlock x:Name="MH_Reject_Text" Text="{Binding Label_MH_Reject}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_OutOfStock" Command="{Binding OutOfStockCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_OutOfStock_Icon"/>
                            <TextBlock x:Name="MH_OutOfStock_Text" Text="{Binding Label_MH_OutOfStock}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Details" Command="{Binding DetailsCommand}" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Details_Icon"/>
                            <TextBlock x:Name="MH_Details_Text" Text="{Binding Label_MH_Details}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Menu" Command="{Binding ReduceCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Menu_Icon"/>
                            <TextBlock x:Name="MH_Menu_Text" Text="{Binding Label_MH_Menu}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</generic:MH_Generic>