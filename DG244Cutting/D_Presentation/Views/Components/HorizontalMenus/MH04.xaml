<!-- ============================================================
     MH04 — MENU HORIZONTAL ASSOCIÉ À Page04
     ============================================================
     Contexte : Menu horizontal de la page d'administration des
     comptes utilisateurs (Page04). Expose les quatre boutons
     transverses standards du socle (MH_Menu bindé sur
     ReduceCommand au titre de la doctrine du double rôle,
     MH_Home, MH_Previous, MH_Refresh) augmentés de quatre
     boutons d'action métier MH_New, MH_Add, MH_Modify et
     MH_Save.

     Objectif : Offrir à l'opérateur habilité quatre points
     d'action sur la page courante — entrer en création,
     ajouter, entrer en édition, enregistrer —, relayés vers le
     contrat IV_Page04 par VM_MH04. Deux axes orthogonaux
     gouvernent ces boutons : la visibilité tient aux droits,
     l'activation à l'état d'édition de la page ; un bouton peut
     être visible mais désactivé.

     Comportement : MH04 hérite de MH_Generic (§4.15.9 du 0230)
     et binde son DataContext sur VM_MH04 (§4.15.8 du 0230). La
     visibilité des quatre boutons transverses est gouvernée par
     les implémentations par défaut d'ApplyNavigationRules et
     d'ApplySecurityRules du socle. Les quatre boutons métier
     sont masqués à la déclaration (Visibility="Collapsed") et
     révélés au Loaded par l'override propre d'ApplySecurityRules
     du code-behind, qui évalue les droits métier granulaires
     CanCreate et CanUpdate sur la page hôte ; la répartition
     entre les deux points d'extension étant gouvernée par la
     nature du prédicat consulté (§4.13.4.2 du 0230), aucun
     override d'ApplyNavigationRules n'est requis. Leur
     stylisation est portée par l'override propre d'ApplyLayout.
     ============================================================ -->

<generic:MH_Generic x:Class="DG244Cutting.D_Presentation.Views.Components.HorizontalMenus.MH04"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:generic="clr-namespace:DG244Cutting.D_Presentation.Views.Generic"
                    mc:Ignorable="d">

    <Grid x:Name="MH_Grid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MH_Grid_C1"/>
            <ColumnDefinition x:Name="MH_Grid_C2"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="MH_Border" Grid.Column="1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="MH_Home" Command="{Binding HomeCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Home_Icon"/>
                            <TextBlock x:Name="MH_Home_Text" Text="{Binding Label_MH_Home}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Previous" Command="{Binding PreviousCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Previous_Icon"/>
                            <TextBlock x:Name="MH_Previous_Text" Text="{Binding Label_MH_Previous}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Refresh" Command="{Binding RefreshCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Refresh_Icon"/>
                            <TextBlock x:Name="MH_Refresh_Text" Text="{Binding Label_MH_Refresh}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MH_New" Command="{Binding NewCommand}" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_New_Icon"/>
                            <TextBlock x:Name="MH_New_Text" Text="{Binding Label_MH_New}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Add" Command="{Binding AddCommand}" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Add_Icon"/>
                            <TextBlock x:Name="MH_Add_Text" Text="{Binding Label_MH_Add}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Modify" Command="{Binding ModifyCommand}" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Modify_Icon"/>
                            <TextBlock x:Name="MH_Modify_Text" Text="{Binding Label_MH_Modify}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Save" Command="{Binding SaveCommand}" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Save_Icon"/>
                            <TextBlock x:Name="MH_Save_Text" Text="{Binding Label_MH_Save}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MH_Menu" Command="{Binding ReduceCommand}" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Vertical">
                            <Image x:Name="MH_Menu_Icon"/>
                            <TextBlock x:Name="MH_Menu_Text" Text="{Binding Label_MH_Menu}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</generic:MH_Generic>
